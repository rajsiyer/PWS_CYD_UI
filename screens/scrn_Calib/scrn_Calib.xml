<screen>
	<view extends="lv_obj" style_bg_color="0x2c0f01" style_bg_opa="100%">
		<!-- Add your code here -->
		<button name="butnHome" x="5" y="201" bg_color="0x8a0e05" text="Home" radius="10">
			<screen_load_event trigger="clicked" anim_type="none" duration="0" delay="0" screen="scrn_Home" />
		</button>

		<text name="Dry1" x="15" y="65" style_text_color="0xf48c59" bind_text="sjt_p1Dry" bind_text-fmt="%d" />

		<text name="Dry2" x="15" y="95" style_text_color="0xf48c59" bind_text="sjt_p2Dry" bind_text-fmt="%d" />

		<text name="Dry3" x="15" y="125" style_text_color="0xf48c59" bind_text="sjt_p3Dry" bind_text-fmt="%d" />

		<text name="Dry4" x="15" y="155" style_text_color="0xf48c59" bind_text="sjt_p4Dry" bind_text-fmt="%d" />

		<text name="R1" x="120" y="65" style_text_color="0x86fa7e" bind_text="subject_raw1" bind_text-fmt="%d" />

		<text name="R2" x="120" y="95" style_text_color="0x86fa7e" bind_text="subject_raw2" bind_text-fmt="%d" />

		<text name="R3" x="120" y="125" style_text_color="0x86fa7e" bind_text="subject_raw3" bind_text-fmt="%d" />

		<text name="R4" x="120" y="155" style_text_color="0x86fa7e" bind_text="subject_raw4" bind_text-fmt="%d" />

		<text name="Wet1" x="215" y="65" style_text_color="0x6e67f3" bind_text="sjt_p1Wet" bind_text-fmt="%d" />

		<text name="Wet2" x="215" y="95" style_text_color="0x6e67f3" bind_text="sjt_p2Wet" bind_text-fmt="%d" />

		<text name="Wet3" x="215" y="125" style_text_color="0x6e67f3" bind_text="sjt_p3Wet" bind_text-fmt="%d" />

		<text name="Wet4" x="215" y="155" style_text_color="0x6e67f3" bind_text="sjt_p4Wet" bind_text-fmt="%d" />

		<text
			name="Moist1"
			x="278"
			y="65"
			style_text_color="0x86fa7e"
			bind_text="subject_moisture1"
			bind_text-fmt="%d"
			height="17"
			width="30"
		/>

		<text
			name="Moist2"
			y="95"
			style_text_color="0x86fa7e"
			bind_text="subject_moisture2"
			bind_text-fmt="%d"
			x="278"
			width="30"
		/>

		<text
			name="Moist3"
			y="125"
			style_text_color="0x86fa7e"
			bind_text="subject_moisture3"
			bind_text-fmt="%d"
			x="278"
			width="30"
		/>

		<text
			name="Moist4"
			y="155"
			style_text_color="0x86fa7e"
			bind_text="subject_moisture4"
			bind_text-fmt="%d"
			x="278"
			width="30"
		/>
		<h5 name="h5_1" text="Sensor Calibration" style_text_color="0xfff887" width="200" height="20" x="70" y="6" />

		<text name="text_1" x="240" style_text_color="0x86fa7e" text="% Moist" y="38" />
		<text name="text_2" style_text_color="0x86fa7e" x="105" text="Raw" y="38" />

		<button name="bD_1" height="25" x="76" y="59" bg_color="0x8a4806" text="" width="38" icon="icon_arrow_left">
			<event_cb trigger="clicked" callback="on_save_request" user_data="0" />
		</button>

		<button name="bD_2" height="25" x="75" bg_color="0x8a4806" text="" width="38" icon="icon_arrow_left" y="90">
			<event_cb trigger="clicked" callback="on_save_request" user_data="1" />
		</button>

		<button name="bD_3" height="25" x="75" y="120" bg_color="0x8a4806" text="" width="38" icon="icon_arrow_left">
			<event_cb trigger="clicked" callback="on_save_request" user_data="2" />
		</button>

		<button name="bD_4" height="25" x="75" y="150" bg_color="0x8a4806" text="" width="38" icon="icon_arrow_left">
			<event_cb trigger="clicked" callback="on_save_request" user_data="3" />
		</button>

		<button name="bW_1" height="25" x="170" y="60" bg_color="0x06218a" text="" width="38" icon="icon_arrow_right">
			<event_cb trigger="clicked" callback="on_save_request" user_data="4" />
		</button>

		<button name="bW_2" height="25" x="170" y="90" bg_color="0x06218a" text="" width="38" icon="icon_arrow_right">
			<event_cb trigger="clicked" callback="on_save_request" user_data="5" />
		</button>

		<button name="bW_3" height="25" x="170" y="120" bg_color="0x06218a" text="" width="38" icon="icon_arrow_right">
			<event_cb trigger="clicked" callback="on_save_request" user_data="6" />
		</button>

		<button name="bW_4" height="25" x="170" y="150" bg_color="0x06218a" text="" width="38" icon="icon_arrow_right">
			<event_cb trigger="clicked" callback="on_save_request" user_data="7" />
		</button>
		<lv_obj
			name="confirm_overlay"
			x="0"
			y="0"
			width="320"
			height="240"
			style_bg_color="0x000000"
			style_bg_opa="60%"
			style_border_width="0"
			style_radius="0"
		>
			<bind_flag_if_eq subject="show_confirm" flag="hidden" ref_value="0" />

			<lv_obj
				name="confirm_box"
				align="center"
				width="240"
				height="110"
				style_bg_color="0x2c2c2c"
				style_radius="10"
				style_pad_all="10"
			>
				<text name="confirm_msg" bind_text="sjt_confirm_message" bind_text-fmt="%s" align="top_mid" y="8" />

				<lv_button name="btn_ok" align="bottom_left" x="10" width="90" height="32">
					<text text="OK" align="center" />
					<event_cb trigger="clicked" callback="on_confirm_ok" />
					<subject_set_int_event trigger="clicked" subject="show_confirm" value="0" />
				</lv_button>

				<lv_button name="btn_cancel" align="bottom_right" x="-10" width="90" height="32">
					<text name="confirm_cancel_label" text="Cancel" align="center" />
					<event_cb trigger="clicked" callback="on_confirm_cancel" />
					<subject_set_int_event trigger="clicked" subject="show_confirm" value="0" />
				</lv_button>
			</lv_obj>
		</lv_obj>
	</view>
</screen>
